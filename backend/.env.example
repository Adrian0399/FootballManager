# Kaibil Football — backend environment template
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit a real `.env`. CI/CD injects these values from GitHub
# Secrets (see `.github/workflows/*`). Each environment (dev / uat / prod)
# has its own secrets; the code is identical, only the values change.

# ---- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000

# ---- Database --------------------------------------------------------------
# Local: docker compose (see `docker/docker-compose.yml`)
DATABASE_URL="postgresql://postgres:changeme_in_prod@localhost:5432/kaibil_football_league_manager?schema=public"

# ---- JWT (REQUIRED in every non-local environment) -------------------------
# Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ------------------------------------------------------------------
# The exact frontend origin for THIS environment (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# ---- Security --------------------------------------------------------------
BCRYPT_SALT_ROUNDS=10

# ---- Cookies ---------------------------------------------------------------
# COOKIE_DOMAIN=localhost  → set to the real domain in uat/prod.
COOKIE_DOMAIN=localhost
# COOKIE_SECURE=true is MANDATORY in uat/prod (HTTPS only).
COOKIE_SECURE=false

# ---- Photo uploads ---------------------------------------------------------
# Local: a directory on disk. Serverless hosts: mount a volume or swap the
# storage layer for S3/R2 (see `photo.service.ts`).
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
# Used to build the absolute photo URLs stored in the DB.
PUBLIC_BASE_URL=http://localhost:3000