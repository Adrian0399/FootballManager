# Kaibil Football — frontend environment template
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser and inlined
# at BUILD time — never put a secret here.
#
# `.env.[mode]` files are picked up automatically by Vite:
#   dev  → `pnpm dev`          (development)
#   build→ `pnpm build`        (production)
#   `pnpm build --mode uat`    (UAT build)

# Base URL of the API.
# - Leave as the RELATIVE "/api/v1" when the frontend and the API are served
#   from the same origin (recommended: keeps builds portable across dev/uat/prod).
# - Set an absolute URL (e.g. https://api.example.com/api/v1) only when the
#   API lives on a different domain, and add that origin to the backend's
#   CORS_ORIGIN.
VITE_API_BASE_URL=/api/v1

# Optional: enables the React Router future flags / devtools.
# VITE_ENABLE_DEVTOOLS=false